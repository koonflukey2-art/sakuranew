# Rate limit zones (define in http context if this file is included there)
limit_req_zone $binary_remote_addr zone=webhook_zone:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=ai_zone:10m rate=2r/s;

server {
  listen 443 ssl;
  server_name sakura-production.online;

  ssl_certificate /etc/letsencrypt/live/sakura-production.online/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/sakura-production.online/privkey.pem;

  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always; # enable after HTTPS is fully stable

  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  proxy_connect_timeout 5s;
  proxy_read_timeout 60s;
  proxy_send_timeout 60s;

  # A) presence: ไม่เข้า node (ลดโหลดหนักมาก)
  location = /api/presence/ping {
    # ยังเข้า node เพื่ออัปเดต last seen แต่กันยิงถี่เกิน
    limit_req zone=presence_zone burst=5;
    limit_conn perip_conn 5;
    proxy_pass http://127.0.0.1:3000;
  }

  # Cron endpoints: allow only localhost
  location ^~ /api/cron/ {
    allow 127.0.0.1;
    deny all;
    proxy_pass http://127.0.0.1:3000;
  }

  # Webhooks: rate limit
  location = /api/webhooks/line {
    limit_req zone=webhook_zone burst=20 nodelay;
    proxy_pass http://127.0.0.1:3000;
  }

  location = /api/webhooks/line-ads {
    limit_req zone=webhook_zone burst=20 nodelay;
    proxy_pass http://127.0.0.1:3000;
  }

  location ^~ /api/line/webhook/ {
    limit_req zone=webhook_zone burst=20 nodelay;
    proxy_pass http://127.0.0.1:3000;
  }

  # AI endpoints: rate limit
  location = /api/ai-chat {
    limit_req zone=ai_zone burst=10 nodelay;
    proxy_pass http://127.0.0.1:3000;
  }

  location = /api/ai/chat {
    limit_req zone=ai_zone burst=10 nodelay;
    proxy_pass http://127.0.0.1:3000;
  }

  location = /api/line/ai-parse {
    limit_req zone=ai_zone burst=10 nodelay;
    proxy_pass http://127.0.0.1:3000;
  }

  # B) notifications: จำกัดถี่ๆ แบบ "หน่วง" (ไม่ใช้ nodelay)
  location = /api/notifications {
    # ถ้าไม่มี cookie (ยังไม่ได้ login) ตัดจบที่ nginx ไม่ต้องเข้า node
    if ($has_cookie = 0) { return 401; }

    # จำกัดความถี่แบบไม่ nodelay (ให้หน่วงได้ใน burst)
    limit_req zone=notif_zone burst=120;
    limit_conn perip_conn 10;

    proxy_pass http://127.0.0.1:3000;
  }

  # ทุกอย่างที่เหลือเข้า node ปกติ
  location / {
    proxy_pass http://127.0.0.1:3000;
  }
}

server {
  listen 80;
  server_name sakura-production.online;
  return 301 https://$host$request_uri;
}
