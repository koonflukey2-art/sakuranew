services:
  db:
    restart: unless-stopped
    image: postgres:16
    environment:
      POSTGRES_DB: sakuranew
      POSTGRES_USER: sakuranew
      POSTGRES_PASSWORD: DB_PASS_CHANGE_ME
    volumes:
      - pgdata:/var/lib/postgresql/data

  app:
    restart: unless-stopped
    build: .
    environment:
      - UPLOAD_DIR=/data/uploads/statements
    env_file:
      - .env.production
    depends_on:
      - db
    ports:
      - "127.0.0.1:3000:3000"

    volumes:
      - /opt/sakuranew/data/uploads:/data/uploads
volumes:
  pgdata:
  uploads:
