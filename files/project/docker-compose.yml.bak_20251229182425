services:
  db:
    image: postgres:16
    environment:
      POSTGRES_DB: sakuranew
      POSTGRES_USER: sakuranew
      POSTGRES_PASSWORD: DB_PASS_CHANGE_ME
    volumes:
      - pgdata:/var/lib/postgresql/data
    restart: unless-stopped

  app:
    environment:
      - AUTH_TRUST_HOST=true
      - NEXTAUTH_URL=https://sakura-production.online
      - AUTH_URL=http://sakura-production.online
      - AUTH_TRUST_HOST=true
      - NEXTAUTH_URL=https://sakura-production.online
      - AUTH_URL=http://sakura-production.online
    build: .
    env_file:
      - .env.production
    depends_on:
      - db
    ports:
      :3000"
    volumes:
      - uploads:/app/uploads
    restart: unless-stopped

volumes:
  pgdata:
  uploads:
