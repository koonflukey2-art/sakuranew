import { NextRequest, NextResponse } from "next/server";
import React from "react";
import { pdf, Document, Page, Text, View, StyleSheet } from "@react-pdf/renderer";

import { prisma } from "@/lib/prisma";
import { getCurrentUser } from "@/lib/auth";
import { getOrganizationId } from "@/lib/organization";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

const h = React.createElement;

const styles = StyleSheet.create({
  page: { fontSize: 10, padding: 28 },
  header: { marginBottom: 12 },
  title: { fontSize: 16, marginBottom: 6 },
  sub: { color: "#444", marginBottom: 10 },
  row: { flexDirection: "row", borderBottomWidth: 1, borderBottomColor: "#E5E7EB", paddingVertical: 6 },
  colA: { width: "18%", paddingRight: 6 },
  colB: { width: "42%", paddingRight: 6 },
  colC: { width: "12%", textAlign: "right", paddingRight: 6 },
  colD: { width: "14%", textAlign: "right", paddingRight: 6 },
  colE: { width: "14%", textAlign: "right" },
  th: { fontWeight: 700 },
});

function S(v: any) {
  if (v === null || v === undefined) return "";
  if (typeof v === "string") return v;
  if (typeof v === "number" || typeof v === "boolean") return String(v);
  if (v instanceof Date) return v.toISOString();
  return String(v);
}

function fmtMoney(v: any) {
  const n = Number(v);
  if (!isFinite(n)) return "0";
  return n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function fmtDate(d: any) {
  try {
    const dt = d instanceof Date ? d : new Date(d);
    if (isNaN(dt.getTime())) return "";
    return dt.toLocaleString("th-TH", { timeZone: "Asia/Bangkok" });
  } catch {
    return "";
  }
}

type Row = {
  orderDate: any;
  productName: any;
  quantity: any;
  amount: any;
  status: any;
};

function ReportDoc(props: { orgName: string; reportDate: string; rows: Row[] }) {
  const total = props.rows.reduce((sum, r) => sum + (Number(r.amount) || 0), 0);

  return (
    <Document>
      <Page size="A4" style={styles.page} wrap>
        <View style={styles.header}>
          <Text style={styles.title}>Orders Report</Text>
          <Text style={styles.sub}>{S(props.orgName)} • {S(props.reportDate)}</Text>
          <Text style={styles.sub}>Total: {fmtMoney(total)}</Text>
        </View>

        <View style={[styles.row]}>
          <Text style={[styles.colA, styles.th]}>Date</Text>
          <Text style={[styles.colB, styles.th]}>Product</Text>
          <Text style={[styles.colC, styles.th]}>Qty</Text>
          <Text style={[styles.colD, styles.th]}>Amount</Text>
          <Text style={[styles.colE, styles.th]}>Status</Text>
        </View>

        {props.rows.map((r, i) => (
          <View key={i} style={styles.row}>
            <Text style={styles.colA}>{S(fmtDate(r.orderDate))}</Text>
            <Text style={styles.colB}>{S(r.productName)}</Text>
            <Text style={styles.colC}>{S(r.quantity)}</Text>
            <Text style={styles.colD}>{S(fmtMoney(r.amount))}</Text>
            <Text style={styles.colE}>{S(r.status)}</Text>
          </View>
        ))}
      </Page>
    </Document>
  );
}

export async function GET(req: NextRequest) {
  try {
    const user = await getCurrentUser();
    if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

    const orgId = await getOrganizationId();
    if (!orgId) return NextResponse.json({ error: "No organization" }, { status: 400 });

    const { searchParams } = new URL(req.url);
    const date = searchParams.get("date");
    if (!date) return NextResponse.json({ error: "Missing ?date=YYYY-MM-DD" }, { status: 400 });

    // วันตามเวลาไทย: [00:00:00, 24:00:00)
    const start = new Date(`${date}T00:00:00+07:00`);
    const end = new Date(`${date}T24:00:00+07:00`);

    // ✅ ถ้าโปรเจกต์คุณไม่ได้ชื่อ model ว่า "order" ให้ดู src/app/api/orders/route.ts แล้วแก้ตรงนี้
    const orders = await prisma.order.findMany({
      where: {
        organizationId: orgId,
        createdAt: { gte: start, lt: end },
      },
      select: {
        createdAt: true,
        status: true,
        quantity: true,
        amount: true,
        productName: true,
      },
      orderBy: { createdAt: "asc" },
    });

    const rows: Row[] = orders.map((o: any) => ({
      orderDate: o.createdAt,
      productName: o.productName,
      quantity: o.quantity,
      amount: o.amount,
      status: o.status,
    }));

    const element = h(ReportDoc as any, {
      orgName: "Sakura",
      reportDate: date,
      rows,
    });

    const buf: any = await pdf(element as any).toBuffer();

    return new NextResponse(buf, {
      headers: {
        "Content-Type": "application/pdf",
        "Content-Disposition": `attachment; filename="orders-${date}.pdf"`,
        "Cache-Control": "no-store",
      },
    });
  } catch (e: any) {
    console.error("PDF ERROR:", e?.stack || e);
    return NextResponse.json({ error: "Failed to generate PDF" }, { status: 500 });
  }
}
