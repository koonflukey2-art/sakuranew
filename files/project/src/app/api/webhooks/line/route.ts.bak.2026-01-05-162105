// src/app/api/webhooks/line/route.ts
import { NextRequest, NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import crypto from "crypto";
import { replyLineMessage, sendLineNotify } from "@/lib/line-integration";
import { parseLineMessage } from "@/lib/line-parser";
import { getDailySequence, resetDailySequenceIfNeeded } from "@/lib/daily-counter";

export const runtime = "nodejs";

function verifyLineSig(rawBody: Buffer, channelSecret: string, signature: string) {
  try {
    const hash = crypto
      .createHmac("sha256", channelSecret)
      .update(rawBody)
      .digest(); // Buffer

    const sig = Buffer.from((signature || "").trim(), "base64");
    if (sig.length !== hash.length) return false;
    return crypto.timingSafeEqual(hash, sig);
  } catch {
    return false;
  }
}

type LineWebhookEvent = {
  type?: string;
  replyToken?: string;
  message?: {
    type?: string;
    text?: string;
  };
};

function uniqueUnknownPhone() {
  return `UNKNOWN-${Date.now()}-${Math.floor(Math.random() * 10000)}`;
}

export async function POST(request: NextRequest) {
  let body = "";
  let rawBuf: Buffer | null = null;

  try {
    rawBuf = Buffer.from(await request.arrayBuffer());
    body = rawBuf.toString("utf8");

    const signature = request.headers.get("x-line-signature") || "";

    if (!signature) {
      // กัน request ที่ไม่ใช่จาก LINE / กัน LINE retry รัว
      return NextResponse.json({ ok: true }, { status: 200 });
    }

    // ✅ ถ้าคุณมีหลาย org ควรเลือกตาม org ที่ active
    const settings = await prisma.systemSettings.findFirst({
      where: {
        lineChannelSecret: { not: null },
        lineChannelAccessToken: { not: null },
      },
      orderBy: { updatedAt: "desc" },
    });

    if (!settings?.lineChannelSecret || !settings.lineChannelAccessToken) {
      console.error("LINE not configured (lineChannelSecret/lineChannelAccessToken)");
      return NextResponse.json({ ok: true }, { status: 200 });
    }

    const valid = rawBuf ? verifyLineSig(rawBuf, settings.lineChannelSecret, signature) : false;
    if (!valid) {
      console.error("Invalid LINE signature", {
        sigLen: signature.length,
        bodyLen: rawBuf ? rawBuf.length : 0,
        secretLen: settings.lineChannelSecret ? settings.lineChannelSecret.length : 0,
      });
      // ตอบ 200 เพื่อไม่ให้ LINE ยิงซ้ำถี่
      return NextResponse.json({ ok: true }, { status: 200 });
    }

    let parsed: unknown;
    try {
      parsed = JSON.parse(body);
    } catch (err) {
      console.error("Invalid JSON body:", err);
      return NextResponse.json({ ok: true }, { status: 200 });
    }

    const data = parsed as { events?: unknown };
    const events: LineWebhookEvent[] = Array.isArray(data.events)
      ? (data.events as LineWebhookEvent[])
      : [];

    for (const event of events) {
      if (event.type !== "message") continue;
      if (event.message?.type !== "text") continue;

      const messageText: string = event.message.text || "";
      const replyToken: string = event.replyToken || "";

      if (!replyToken) continue;

      // ✅ parse รูปแบบใหม่หลายบรรทัด
      const orderData = parseLineMessage(messageText);

      if (!orderData) {
        const help =
          "รูปแบบไม่ถูกต้อง ✅\n\n" +
          "ส่งตามนี้ได้เลย:\n" +
          "1\n" +
          "เก็บยอด 390 บาท\n" +
          "63.ซอยเจริญกรุง14\n" +
          "ถนนเจริญกรุง\n" +
          "เขตสัมพันธวงศ์ แขวงสัมพันธวงศ์\n" +
          "กรุงเทพ 10100\n" +
          "095-503-0658\n" +
          "ปาน สีเสน\n" +
          "2\n\n" +
          "*บรรทัดแรก=ประเภทสินค้า, บรรทัดสุดท้าย=จำนวน\n" +
          "*เบอร์ใส่เว้นวรรค/ขีดได้";
        await replyLineMessage(replyToken, settings.lineChannelAccessToken, help);
        continue;
      }

      const product = await prisma.product.findFirst({
        where: {
          organizationId: settings.organizationId,
          productType: orderData.productType,
        },
      });

      if (!product) {
        await replyLineMessage(
          replyToken,
          settings.lineChannelAccessToken,
          `❌ ไม่พบสินค้าประเภท ${orderData.productType}\n\n` +
            `กรุณาสร้างสินค้าประเภทนี้ในระบบก่อน\n` +
            `หรือตรวจสอบหมายเลขประเภทสินค้า`
        );
        continue;
      }

      if (product.quantity < orderData.quantity) {
        await replyLineMessage(
          replyToken,
          settings.lineChannelAccessToken,
          `❌ สต็อกไม่พอ!\n\n` +
            `สินค้า: ${product.name}\n` +
            `สต็อกคงเหลือ: ${product.quantity} ชิ้น\n` +
            `ต้องการ: ${orderData.quantity} ชิ้น`
        );
        continue;
      }

      await resetDailySequenceIfNeeded(settings.organizationId);
      const dailySequence = await getDailySequence(settings.organizationId);

      const today = new Date();
      const dateStr = today.toISOString().split("T")[0].replace(/-/g, "");
      const orderNumber = `ORD-${dateStr}-${String(dailySequence).padStart(3, "0")}`;

      // ✅ customer จากข้อความ (แยกเบอร์ได้หลายแบบ)
      const phoneDigits = (orderData.phone || "").replace(/\D/g, "");
      const safePhone =
        phoneDigits && (phoneDigits.length === 9 || phoneDigits.length === 10)
          ? phoneDigits
          : uniqueUnknownPhone();

      const customerName = (orderData.customerName || "").trim() || "ลูกค้า LINE";
      const customerAddress = orderData.address || "จาก LINE";

      let customer = await prisma.customer.findFirst({
        where: { organizationId: settings.organizationId, phone: safePhone },
      });

      if (!customer) {
        customer = await prisma.customer.create({
          data: {
            organizationId: settings.organizationId,
            name: customerName,
            phone: safePhone,
            address: customerAddress || null,
          },
        });
      } else {
        // อัปเดตแบบไม่ทำลายของเดิม
        await prisma.customer.update({
          where: { id: customer.id },
          data: {
            name: customer.name === "ลูกค้า LINE" ? customerName : customer.name,
            address: customerAddress || customer.address,
          },
        });
      }

      const order = await prisma.order.create({
        data: {
          organizationId: settings.organizationId,
          orderNumber,
          dailySequence,
          productType: orderData.productType,
          productName: product.name,
          quantity: orderData.quantity,
          amount: orderData.amount,
          unitPrice: orderData.amount / orderData.quantity,
          source: "LINE",
          status: "PENDING",
          customerId: customer.id,
          orderDate: new Date(),
          rawMessage: messageText,
        },
      });

      await prisma.product.update({
        where: { id: product.id },
        data: { quantity: { decrement: orderData.quantity } },
      });

      const cutOffHour =
        typeof settings.dailyCutOffHour === "number" ? settings.dailyCutOffHour : 0;
      const cutOffMinute =
        typeof settings.dailyCutOffMinute === "number" ? settings.dailyCutOffMinute : 0;

      await replyLineMessage(
        replyToken,
        settings.lineChannelAccessToken,
        `✅ รับออเดอร์แล้ว!\n\n` +
          `📋 รายการที่ ${dailySequence} (วันนี้)\n` +
          `เลขที่: ${order.orderNumber}\n` +
          `สินค้า: ${product.name}\n` +
          `ประเภท: ${orderData.productType}\n` +
          `จำนวน: ${orderData.quantity} ชิ้น\n` +
          `ราคา: ฿${orderData.amount.toLocaleString("th-TH")}\n` +
          (phoneDigits ? `📞 เบอร์: ${phoneDigits}\n` : "") +
          `\n🕐 รอตัดยอดเวลา ${String(cutOffHour).padStart(2, "0")}:${String(
            cutOffMinute
          ).padStart(2, "0")} น.`
      );

      if (settings.notifyOnOrder && settings.lineNotifyToken) {
        await sendLineNotify(
          settings.lineNotifyToken,
          `🔔 ออเดอร์ใหม่ - รายการที่ ${dailySequence}\n\n` +
            `เลขที่: ${order.orderNumber}\n` +
            `สินค้า: ${product.name}\n` +
            `ประเภท: ${orderData.productType}\n` +
            `จำนวน: ${orderData.quantity} ชิ้น\n` +
            `ราคา: ฿${orderData.amount.toLocaleString("th-TH")}` +
            (phoneDigits ? `\nเบอร์: ${phoneDigits}` : "")
        );
      }

      // NOTE: แจ้งสต็อกต่ำ (หลังตัดสต็อกแล้ว product.quantity ในตัวแปรยังค่าเดิม)
      // ถ้าต้องการแม่น ให้คำนวณคงเหลือใหม่
      const remaining = product.quantity - orderData.quantity;

      if (
        remaining < product.minStockLevel &&
        settings.notifyOnLowStock &&
        settings.lineNotifyToken
      ) {
        await sendLineNotify(
          settings.lineNotifyToken,
          `⚠️ สต็อกต่ำ!\nสินค้า: ${product.name}\nเหลือ: ${remaining} ชิ้น`
        );
      }
    }

    return NextResponse.json({ ok: true }, { status: 200 });
  } catch (e: unknown) {
    console.error("LINE webhook error:", e);
    // ✅ ตอบ 200 เสมอ กัน retry
    return NextResponse.json({ ok: true }, { status: 200 });
  }
}

export async function GET(_req: NextRequest) {
  return NextResponse.json({ status: "ok", message: "LINE webhook ready" });
}
