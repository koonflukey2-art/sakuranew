
export interface ParsedOrder {
  productType: number;
  productName: string;
  amount: number;
  unitPrice: number;
  quantity: number;
  customerName: string;
  phone: string;
  address: string;
}

export type ParsedLineMessage = {
  productType: number;
  quantity: number;
  amount: number;
  productName?: string;
  phone?: string;        // digits only
  customerName?: string;
  address?: string;
};

function normalizeLines(raw: string) {
  return raw
    .replace(/\r\n/g, "\n")
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.length > 0);
}

function isIntLine(s: string) {
  return /^[0-9]{1,4}$/.test(s.trim());
}

function extractAmount(lines: string[]) {
  const re =
    /(เก็บยอด|ยอดเก็บ)\s*[:：]?\s*(?:฿\s*)?([0-9][0-9,]*(?:\.[0-9]+)?)\s*(?:บาท)?/;
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(re);
    if (m) {
      const amt = Number(String(m[2]).replace(/,/g, ""));
      if (Number.isFinite(amt) && amt > 0) return { amount: amt, index: i };
    }
  }
  return { amount: null as number | null, index: -1 };
}

function extractPhone(lines: string[]) {
  // จับ: 0912345678, 098 123 4568, 095-503-0658
  const phoneRe = /0\d[\d\s-]{7,14}\d/;
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(phoneRe);
    if (m) {
      const digits = m[0].replace(/\D/g, "");
      if (digits.startsWith("0") && (digits.length === 9 || digits.length === 10)) {
        return { phone: digits, index: i };
      }
    }
  }
  return { phone: null as string | null, index: -1 };
}



export function parseLineMessage(message: string): ParsedOrder | null {
  const raw = String(message ?? "").replace(/\r/g, "").trim();
  if (!raw) return null;

  const lines = raw
    .split("\n")
    .map((l) => l.trim())
    .filter(Boolean);

  // ต้องมีอย่างน้อย: ประเภทสินค้า + อะไรสักอย่าง
  if (lines.length < 2) return null;

  // ---------- helpers ----------
  const hasThai = (s: string) => /[ก-๙]/.test(s);

  // เบอร์ไทย: รองรับ 0953214569 / 095-357-4569 / 095 357 4569
  const phoneRe = /0\d[\d\s-]{7,14}\d/g;
  const normalizePhone = (s: string) => s.replace(/\D/g, "");
  const extractPhone = (text: string) => {
    const ms = text.match(phoneRe);
    if (!ms) return null;
    for (const m of ms) {
      const d = normalizePhone(m);
      if (d.startsWith("0") && (d.length === 9 || d.length === 10)) return d;
    }
    return null;
  };
  const stripPhone = (s: string) => s.replace(phoneRe, "").trim();

  // เงิน: ดึงเลขตัวแรกที่เป็นจำนวนเงิน (รองรับคอมม่า)
  const moneyRe = /(\d+(?:,\d{3})*(?:\.\d+)?)/;
  const parseMoneyFromLine = (s: string) => {
    const m = s.match(moneyRe);
    if (!m) return 0;
    const n = parseFloat(m[1].replace(/,/g, ""));
    return Number.isFinite(n) ? n : 0;
  };

  // จำนวน: ปกติจะเป็นบรรทัดตัวเลขสั้น ๆ ท้ายข้อความ
  const isQtyLine = (s: string) => /^\d{1,4}$/.test(s.trim());

  // ไปรษณีย์: 5 หลัก (ไม่ใช่ชื่อ)
  const isPostalLine = (s: string) => /^\d{5}$/.test(s.trim());

  // คีย์เวิร์ดที่อยู่ (รวม ต./อ./จ. ให้แน่นขึ้น)
  const addressKw =
    /(ถนน|ซอย|หมู่|หมู่ที่|ม\.|เลขที่|บ้านเลขที่|หมู่บ้าน|คอนโด|อาคาร|ชั้น|ต\.|ตำบล|แขวง|อ\.|อำเภอ|เขต|จ\.|จังหวัด|กทม|กรุงเทพ|รหัสไปรษณีย์|ไปรษณีย์)/;

  const moneyPrefer = /(ยอด|เก็บ|บาท|฿)/i;

  // บรรทัดชื่อ: ต้องมีไทย, ไม่มีตัวเลข, ไม่ใช่ที่อยู่, ไม่ใช่บรรทัดเงิน
  // (อนุญาตจุดในคำนำหน้า น.ส. / นาย / นาง)
  const isNameLine = (s: string) => {
    if (!hasThai(s)) return false;
    if (/\d/.test(s)) return false;
    if (addressKw.test(s)) return false;
    if (moneyPrefer.test(s)) return false;
    if (/(โทร|tel|phone)/i.test(s)) return false;
    if (s.length > 60) return false;
    return true;
  };

  const wordsThai = (s: string) =>
    s.split(/\s+/).filter(Boolean).length;

  // ---------- 1) productType ----------
  const firstLine = lines[0];
  const productType = parseInt(firstLine.replace(/[^\d]/g, ""), 10);
  if (!Number.isFinite(productType) || productType <= 0) return null;

  // ---------- 2) quantity (จากท้ายขึ้นบน) ----------
  let quantity = 1;
  let qtyIdx = -1;
  for (let i = lines.length - 1; i >= 0; i--) {
    const l = lines[i];
    if (isPostalLine(l)) continue;
    if (isQtyLine(l)) {
      quantity = Math.max(1, parseInt(l, 10));
      qtyIdx = i;
      break;
    }
  }

  // ---------- 3) phone ----------
  const phone = extractPhone(raw) || "";
  let phoneIdx = -1;
  if (phone) {
    for (let i = 0; i < lines.length; i++) {
      if (extractPhone(lines[i])) {
        phoneIdx = i;
        break;
      }
    }
  }

  // ---------- 4) amount ----------
  let amount = 0;
  let amountIdx = -1;

  // 4.1 หา “ยอดเก็บ/เก็บยอด/ยอด …” ก่อน
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    if (moneyPrefer.test(l)) {
      const n = parseMoneyFromLine(l);
      // กันกรณีไปเจอเลขบ้าน 88/8 ฯลฯ โดยให้รับเฉพาะถ้ามีคำเงิน หรือเป็นบรรทัดยอด
      if (n > 0 && (/(ยอดเก็บ|เก็บยอด|ยอดรวม|ยอด)/i.test(l) || /฿|บาท/.test(l))) {
        amount = n;
        amountIdx = i;
        break;
      }
    }
  }
  // 4.2 ถ้ายังไม่เจอ ให้หาเลขที่ “ดูเหมือนเงิน” (>= 10 บาท) แต่ไม่ใช่จำนวน/ไม่ใช่ไปรษณีย์
  if (amount <= 0) {
    for (let i = 0; i < lines.length; i++) {
      if (i === 0 || i === qtyIdx) continue;
      const l = lines[i];
      if (isPostalLine(l)) continue;
      const n = parseMoneyFromLine(l);
      if (n >= 10) {
        amount = n;
        amountIdx = i;
        break;
      }
    }
  }
  if (amount <= 0) return null;

  // ---------- 5) หา customerName แบบ “ให้คะแนน” ----------
  const excluded = new Set<number>(
    [0, qtyIdx, phoneIdx, amountIdx].filter((x) => x >= 0)
  );

  const scoreName = (i: number, s: string) => {
    if (!isNameLine(s)) return -10_000;
    let score = 0;

    // ชื่อมักอยู่ถัดจากบรรทัดยอด
    if (amountIdx >= 0 && i === amountIdx + 1) score += 6;

    // ชื่ออาจอยู่ก่อนบรรทัดเบอร์ 1 บรรทัด (บางคนส่งชื่อท้าย ๆ)
    if (phoneIdx >= 0 && i === phoneIdx - 1) score += 4;

    // คำนำหน้า
    if (/^(คุณ|นาย|นาง|น\.ส\.|นส\.)/.test(s)) score += 2;

    // ชื่อมักมี 2 คำขึ้นไป
    if (wordsThai(s) >= 2) score += 2;

    // ความยาวกำลังดี
    if (s.length >= 3 && s.length <= 40) score += 1;

    return score;
  };

  let customerName = "";
  let nameIdx = -1;

  // สร้าง candidates ที่ไม่ถูก exclude
  const candidates: { i: number; s: string; score: number }[] = [];
  for (let i = 0; i < lines.length; i++) {
    if (excluded.has(i)) continue;
    const s = lines[i];
    const score = scoreName(i, s);
    candidates.push({ i, s, score });
  }

  // เลือกคะแนนสูงสุด
  candidates.sort((a, b) => b.score - a.score);
  if (candidates.length && candidates[0].score > -1000) {
    customerName = candidates[0].s;
    nameIdx = candidates[0].i;
  }

  // fallback: ถ้ายังไม่เจอ ให้ไล่จากบนลงล่าง เอาบรรทัดไทยที่ไม่ใช่ที่อยู่/ไม่ใช่เงิน
  if (!customerName) {
    for (let i = 0; i < lines.length; i++) {
      if (i === 0 || i === qtyIdx || i === phoneIdx || i === amountIdx) continue;
      const s = lines[i];
      if (isNameLine(s)) {
        customerName = s;
        nameIdx = i;
        break;
      }
    }
  }

  // ---------- 6) address ----------
  const addrParts: string[] = [];
  for (let i = 0; i < lines.length; i++) {
    if (i === 0 || i === qtyIdx || i === phoneIdx || i === amountIdx || i === nameIdx) continue;

    let s = lines[i];
    s = stripPhone(s);
    s = s.replace(/(?:โทร|tel|phone)\s*[:：]?\s*$/i, "").trim();
    if (!s) continue;

    // ไม่เอาบรรทัดที่เป็นเงิน
    if (moneyPrefer.test(s) && parseMoneyFromLine(s) > 0) continue;

    addrParts.push(s);
  }

  let address = addrParts.join(" ").trim();

  // fallback address: ถ้ายังว่าง และมีช่วงระหว่างยอด -> เบอร์ ให้เก็บช่วงนั้นเป็นที่อยู่
  if (!address && amountIdx >= 0) {
    const from = amountIdx + 1;
    const to = (phoneIdx >= 0 ? phoneIdx : (qtyIdx >= 0 ? qtyIdx : lines.length));
    const tmp: string[] = [];
    for (let i = from; i < to; i++) {
      if (i === nameIdx) continue;
      let s = stripPhone(lines[i]);
      if (!s) continue;
      tmp.push(s);
    }
    address = tmp.join(" ").trim();
  }

  // ---------- validation ----------
  if (!customerName) return null;

  const safePhone = phone || `UNKNOWN-${Date.now()}`;
  const productName = `สินค้าประเภท ${productType}`;

  const unitPrice =
    quantity > 0 ? amount / quantity : amount;

  return {
    productType,
    productName,
    amount,
    unitPrice,
    quantity,
    customerName,
    phone: safePhone,
    address,
  };
}
