export type ParsedLineMessage = {
  productType: number;
  quantity: number;
  amount: number;
  productName?: string;
  phone?: string;        // digits only
  customerName?: string;
  address?: string;
};

function normalizeLines(raw: string) {
  return raw
    .replace(/\r\n/g, "\n")
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.length > 0);
}

function isIntLine(s: string) {
  return /^[0-9]{1,4}$/.test(s.trim());
}

function extractAmount(lines: string[]) {
  const re =
    /(เก็บยอด|ยอดเก็บ)\s*[:：]?\s*(?:฿\s*)?([0-9][0-9,]*(?:\.[0-9]+)?)\s*(?:บาท)?/;
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(re);
    if (m) {
      const amt = Number(String(m[2]).replace(/,/g, ""));
      if (Number.isFinite(amt) && amt > 0) return { amount: amt, index: i };
    }
  }
  return { amount: null as number | null, index: -1 };
}

function extractPhone(lines: string[]) {
  // จับ: 0912345678, 098 123 4568, 095-503-0658
  const phoneRe = /0\d[\d\s-]{7,14}\d/;
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(phoneRe);
    if (m) {
      const digits = m[0].replace(/\D/g, "");
      if (digits.startsWith("0") && (digits.length === 9 || digits.length === 10)) {
        return { phone: digits, index: i };
      }
    }
  }
  return { phone: null as string | null, index: -1 };
}



export function parseLineMessage(message: string): ParsedOrder | null {
  const raw = String(message || "").replace(/\r/g, "").trim();
  if (!raw) return null;

  const lines = raw
    .split("\n")
    .map((l) => l.trim())
    .filter(Boolean);

  if (lines.length < 2) return null;

  // ---------- helpers ----------
  const hasThai = (s: string) => /[ก-๙]/.test(s);
  const hasDigit = (s: string) => /\d/.test(s);
  const normalizeDigits = (s: string) => s.replace(/[^\d]/g, "");

  // money patterns: "เก็บยอด 390 บาท", "ยอดเก็บ390", "ยอด 390", "รับยอด 390"
  const extractAmount = (text: string): number => {
    const t = text.replace(/,/g, " ");
    const patterns = [
      /(?:เก็บยอด|ยอดเก็บ|ยอด\s*เก็บ|ยอดรับ|ยอด\s*รับ|ยอดรวม|ยอด)\s*[:：]?\s*([0-9][0-9\s,]*(?:\.\d{1,2})?)\s*(?:บาท)?/i,
    ];
    for (const re of patterns) {
      const m = t.match(re);
      if (m?.[1]) {
        const v = parseFloat(m[1].replace(/[^\d.]/g, ""));
        if (Number.isFinite(v) && v > 0) return v;
      }
    }
    return 0;
  };

  // phone: 0953214569 / 095-357-4569 / 095 357 4569
  const extractPhone = (text: string): string | null => {
    const matches = text.match(/0\d[\d -]{7,14}\d/g);
    if (!matches) return null;
    for (const m of matches) {
      const digits = m.replace(/\D/g, "");
      if ((digits.length === 9 || digits.length === 10) && digits.startsWith("0")) {
        return digits;
      }
    }
    return null;
  };

  const isMoneyLike = (s: string) =>
    /(เก็บยอด|ยอดเก็บ|ยอด\s*เก็บ|ยอดรับ|ยอด\s*รับ|ยอดรวม|ยอด|บาท)/i.test(s);

  const isAddressLike = (s: string) => {
    const addrKw =
      /(ถนน|ซอย|หมู่|หมู่ที่|ต\.|อ\.|จ\.|ตำบล|อำเภอ|จังหวัด|เขต|แขวง|กรุงเทพ|กทม|รหัสไปรษณีย์|บ้านเลขที่|อาคาร|ชั้น|ห้อง)/i;
    return addrKw.test(s) || (hasThai(s) && hasDigit(s));
  };

  const isNoiseName = (s: string) => {
    // กันเคสที่ระบบส่งมาว่า "ลูกค้า LINE" หรือข้อความระบบ
    const noise =
      /(ลูกค้า\s*line|ลูกค้าไลน์|ลูกค้า\s*ไลน์|จาก\s*line|จากไลน์|ไลน์\s*webhook|รับออเดอร์|รายการออเดอร์|ออเดอร์จาก|สรุป|แจ้งเตือน)/i;
    return noise.test(s);
  };

  // ---------- parse ----------
  // productType: first line numeric
  const typeNum = parseInt(normalizeDigits(lines[0] || ""), 10);
  if (!Number.isFinite(typeNum) || typeNum <= 0) return null;

  // quantity: last short numeric line (<= 3 digits) to avoid postcode 10100
  let qty = 1;
  let qtyIndex = -1;
  for (let i = lines.length - 1; i >= 0; i--) {
    const d = normalizeDigits(lines[i]);
    if (!d) continue;
    if (d.length > 3) continue;
    const n = parseInt(d, 10);
    if (Number.isFinite(n) && n > 0 && n <= 999) {
      qty = n;
      qtyIndex = i;
      break;
    }
  }

  const phone = extractPhone(raw) || "";
  const amount = extractAmount(raw);

  // customer name:
  // pick LAST line that:
  // - has Thai
  // - no digits
  // - not money-like
  // - not phone-like
  // - not address-like
  // - not noise ("ลูกค้า LINE")
  let name = "";
  for (let i = lines.length - 1; i >= 0; i--) {
    if (i === 0) continue; // productType line
    if (i === qtyIndex) continue;

    const s = lines[i].trim();
    if (!s) continue;

    if (!hasThai(s)) continue;
    if (hasDigit(s)) continue;
    if (isMoneyLike(s)) continue;
    if (extractPhone(s)) continue;
    if (isAddressLike(s)) continue;
    if (isNoiseName(s)) continue;

    if (s.length < 2 || s.length > 80) continue;

    name = s;
    break;
  }

  // address: join lines excluding productType/qty/name + skip money-line + strip phone from address lines
  const addressParts: string[] = [];
  for (let i = 1; i < lines.length; i++) {
    if (i === qtyIndex) continue;

    const s0 = lines[i].trim();
    if (!s0) continue;
    if (name && s0 === name) continue;

    // strip phone inside line
    let s = s0.replace(/0\d[\d -]{7,14}\d/g, "").trim();

    // skip money line
    if (isMoneyLike(s) && /\d/.test(s)) continue;

    // skip pure digits
    if (/^\d+$/.test(s)) continue;

    // keep likely address / thai lines
    if (isAddressLike(s) || (hasThai(s) && s.length >= 2)) {
      // avoid noise lines
      if (!isNoiseName(s)) addressParts.push(s);
    }
  }

  const address = addressParts.join(" ").replace(/\s+/g, " ").trim();

  // validation
  if (!typeNum || !amount || !name) return null;

  const unitPrice = qty > 0 ? amount / qty : amount;

  return {
    productType: typeNum,
    productName: `สินค้าประเภท ${typeNum}`,
    amount,
    unitPrice,
    quantity: qty,
    customerName: name,
    phone: phone || `UNKNOWN-${Date.now()}`,
    address,
  };
}



