
export interface ParsedOrder {
  productType: number;
  productName: string;
  amount: number;
  unitPrice: number;
  quantity: number;
  customerName: string;
  phone: string;
  address: string;
}

export type ParsedLineMessage = {
  productType: number;
  quantity: number;
  amount: number;
  productName?: string;
  phone?: string;        // digits only
  customerName?: string;
  address?: string;
};

function normalizeLines(raw: string) {
  return raw
    .replace(/\r\n/g, "\n")
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l.length > 0);
}

function isIntLine(s: string) {
  return /^[0-9]{1,4}$/.test(s.trim());
}

function extractAmount(lines: string[]) {
  const re =
    /(เก็บยอด|ยอดเก็บ)\s*[:：]?\s*(?:฿\s*)?([0-9][0-9,]*(?:\.[0-9]+)?)\s*(?:บาท)?/;
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(re);
    if (m) {
      const amt = Number(String(m[2]).replace(/,/g, ""));
      if (Number.isFinite(amt) && amt > 0) return { amount: amt, index: i };
    }
  }
  return { amount: null as number | null, index: -1 };
}

function extractPhone(lines: string[]) {
  // จับ: 0912345678, 098 123 4568, 095-503-0658
  const phoneRe = /0\d[\d\s-]{7,14}\d/;
  for (let i = 0; i < lines.length; i++) {
    const m = lines[i].match(phoneRe);
    if (m) {
      const digits = m[0].replace(/\D/g, "");
      if (digits.startsWith("0") && (digits.length === 9 || digits.length === 10)) {
        return { phone: digits, index: i };
      }
    }
  }
  return { phone: null as string | null, index: -1 };
}



export function parseLineMessage(message: string): ParsedOrder | null {
  const raw = String(message ?? "").replace(/\r/g, "").trim();
  if (!raw) return null;

  const lines = raw
    .split("\n")
    .map((l) => l.trim())
    .filter(Boolean);

  if (lines.length < 2) return null;

  // ---------- helpers ----------
  const hasThai = (s: string) => /[ก-๙]/.test(s);

  // รองรับ: 0953214569 / 095-357-4569 / 095 357 4569
  const phoneRe = /0\d[\d\s-]{7,14}\d/g;
  const normalizePhone = (s: string) => s.replace(/\D/g, "");
  const extractPhone = (text: string) => {
    const ms = text.match(phoneRe);
    if (!ms) return null;
    for (const m of ms) {
      const d = normalizePhone(m);
      if (d.startsWith("0") && (d.length === 9 || d.length === 10)) return d;
    }
    return null;
  };
  const stripPhone = (s: string) => s.replace(phoneRe, "").trim();

  // เงิน: prefer "ยอดเก็บ/เก็บยอด" ก่อน
  const moneyNumberRe = /(\d+(?:,\d{3})*(?:\.\d+)?)/;
  const parseMoneyFromLine = (s: string) => {
    const m = s.match(moneyNumberRe);
    if (!m) return 0;
    const n = parseFloat(m[1].replace(/,/g, ""));
    return Number.isFinite(n) ? n : 0;
  };

  const isQtyLine = (s: string) => /^\d{1,4}$/.test(s.trim()); // 1-9999
  const isPostcodeLine = (s: string) => /^\d{5}$/.test(s.trim());

  // ✅ address keywords (รวม อ./จ./ต. + คำที่อยู่บ่อย)
  const addressKw =
    /(ถนน|ซอย|แขวง|เขต|อำเภอ|ตำบล|จังหวัด|หมู่|ม\.|เลขที่|บ้านเลขที่|หมู่บ้าน|คอนโด|อาคาร|ชั้น|ห้อง|ตึก|แฟลต|กทม|กรุงเทพ|รหัสไปรษณีย์|ไปรษณีย์|โรงเรียน|บริษัท|(?:^|\s)อ[.\uFF0E]|(?:^|\s)จ[.\uFF0E]|(?:^|\s)ต[.\uFF0E])/;

  const moneyKw = /(ยอด|เก็บ|บาท|฿)/i;

  // บรรทัดที่ “ดูเป็นชื่อ” (เข้มขึ้น เพื่อกันที่อยู่หลุดมาเป็นชื่อ)
  const isNameLine = (s: string) => {
    if (!hasThai(s)) return false;
    if (/\d/.test(s)) return false;
    if (addressKw.test(s)) return false;
    if (moneyKw.test(s)) return false;
    if (/(โทร|tel|phone)/i.test(s)) return false;
    if (s.length > 80) return false;
    return true;
  };

  // กรณีชื่อ+ที่อยู่มาในบรรทัดเดียว (เช่น "ปราณีต จางสุริ โรงเรียน....")
  // -> ตัดชื่อด้านหน้าก่อน keyword/เลข แล้วส่งที่เหลือไปเป็น address
  const trySplitNameFromMixed = (s: string) => {
    const cleaned = stripPhone(s).trim();
    const m = cleaned.match(/^([ก-๙]+(?:\s+[ก-๙]+){1,3})\s+(.+)$/);
    if (!m) return null;

    const prefix = m[1].trim();
    const rest = m[2].trim();

    // กัน prefix ที่เป็นคำที่อยู่
    if (/^(ถนน|ซอย|เขต|แขวง|อำเภอ|ตำบล|จังหวัด|หมู่|ม\.|อ[.\uFF0E]|จ[.\uFF0E]|ต[.\uFF0E])/.test(prefix)) return null;
    if (!hasThai(prefix) || /\d/.test(prefix)) return null;

    // rest ต้องดูเหมือน address จริง ๆ
    if (addressKw.test(rest) || /\d/.test(rest) || /(โรงเรียน|บริษัท|หมู่บ้าน|คอนโด|อาคาร|ตึก|ห้อง|ชั้น)/.test(rest)) {
      return { name: prefix, addrRest: rest };
    }
    return null;
  };

  // ---------- 1) productType ----------
  const typeNum = parseInt(lines[0].replace(/[^\d]/g, ""), 10);
  if (!Number.isFinite(typeNum) || typeNum <= 0) return null;

  // ---------- 2) quantity (scan from bottom) ----------
  let quantity = 1;
  let qtyIdx = -1;
  for (let i = lines.length - 1; i >= 0; i--) {
    if (isQtyLine(lines[i])) {
      quantity = Math.max(1, parseInt(lines[i], 10));
      qtyIdx = i;
      break;
    }
  }

  // ---------- 3) phone ----------
  const phone = extractPhone(raw) || `UNKNOWN-${Date.now()}`;
  let phoneIdx = -1;
  if (!phone.startsWith("UNKNOWN-")) {
    for (let i = 0; i < lines.length; i++) {
      if (extractPhone(lines[i])) { phoneIdx = i; break; }
    }
  }

  // ---------- 4) amount ----------
  let amount = 0;
  let amountIdx = -1;

  // prefer lines with keyword "ยอดเก็บ/เก็บยอด/บาท/฿"
  for (let i = 0; i < lines.length; i++) {
    const l = lines[i];
    if (moneyKw.test(l)) {
      const m = parseMoneyFromLine(l);
      // กันหยิบเลขจากเบอร์โทร/ไปรษณีย์
      if (m > 0 && !extractPhone(l) && !isPostcodeLine(l)) { amount = m; amountIdx = i; break; }
    }
  }
  // fallback: first numeric line that is not phone/postcode/qty
  if (amount <= 0) {
    for (let i = 0; i < lines.length; i++) {
      const l = lines[i];
      if (i === 0 || i === qtyIdx) continue;
      if (extractPhone(l)) continue;
      if (isPostcodeLine(l)) continue;
      const m = parseMoneyFromLine(l);
      if (m > 0) { amount = m; amountIdx = i; break; }
    }
  }
  if (amount <= 0) return null;

  // ---------- 5) name + address ----------
  const excluded = new Set([0, amountIdx, qtyIdx, phoneIdx].filter((x) => x >= 0));

  // candidates for further parsing
  const candidates: { i: number; s: string }[] = [];
  for (let i = 0; i < lines.length; i++) {
    if (excluded.has(i)) continue;
    candidates.push({ i, s: lines[i] });
  }

  let customerName = "";
  let address = "";

  // 5.1 try split name from mixed line first
  for (const c of candidates) {
    const sp = trySplitNameFromMixed(c.s);
    if (sp && !customerName) {
      customerName = sp.name;
      // เปลี่ยนบรรทัดนี้ให้เหลือแต่ address เพื่อเอาไปรวมต่อ
      c.s = sp.addrRest || "";
      break;
    }
  }

  // 5.2 normal name line (prefer last one)
  if (!customerName) {
    const nameCandidates = candidates.filter((c) => isNameLine(c.s));
    if (nameCandidates.length > 0) {
      customerName = nameCandidates[nameCandidates.length - 1].s;
      // เอาบรรทัดชื่อออกจาก candidates เพื่อไม่ไปรวมที่อยู่
      const idx = candidates.findIndex((c) => c.s === customerName);
      if (idx >= 0) candidates.splice(idx, 1);
    }
  }

  // 5.3 fallback: last thai line that isn't money/phone/qty (ยอม “หลวม” กว่า isNameLine)
  if (!customerName) {
    for (let i = lines.length - 1; i >= 0; i--) {
      const s = lines[i].trim();
      if (i === 0 || i === amountIdx || i === qtyIdx || i === phoneIdx) continue;
      if (!hasThai(s)) continue;
      if (moneyKw.test(s)) continue;
      if (extractPhone(s)) continue;
      if (addressKw.test(s) && !isNameLine(s)) continue;
      if (!/\d/.test(s)) { customerName = s; break; }
    }
  }

  if (!customerName) return null;

  // address: รวมบรรทัดที่เหลือ
  const addrParts: string[] = [];
  for (const c of candidates) {
    let s = c.s || "";
    s = stripPhone(s);
    s = s.replace(/(?:โทร|tel|phone)\s*[:：]?\s*$/i, "").trim();
    if (!s) continue;

    // กันบรรทัดเงินหลุดมาเป็นที่อยู่
    if (moneyKw.test(s) && parseMoneyFromLine(s) > 0) continue;

    // กันจำนวน (สั้นๆ) แต่ยอม postcode 5 หลัก
    if (isQtyLine(s) && !isPostcodeLine(s)) continue;

    addrParts.push(s);
  }
  address = addrParts.join(" ").trim();

  const unitPrice = quantity > 0 ? amount / quantity : amount;

  return {
    productType: typeNum,
    productName: `สินค้าประเภท ${typeNum}`,
    amount,
    unitPrice,
    quantity,
    customerName,
    phone,
    address,
  };
}


