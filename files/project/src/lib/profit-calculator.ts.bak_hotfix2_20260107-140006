export async function calculateComprehensiveProfit(input: any, organizationId?: any): Promise<any> {
  // โดยมาก route แนว comprehensive จะส่ง { orders: [...] } หรือส่ง array มาเลย
  if (Array.isArray(input) && typeof organizationId === "string") {
    return calculateTotalProfit(toProfitOrderInputs(input), organizationId);
  }

  if (input && typeof input === "object") {
    const orgId =
      typeof organizationId === "string"
        ? organizationId
        : typeof input.organizationId === "string"
          ? input.organizationId
          : typeof input.orgId === "string"
            ? input.orgId
            : undefined;

    const orders = input.orders ?? input.items ?? input.data;

    if (Array.isArray(orders) && typeof orgId === "string") {
      return calculateTotalProfit(toProfitOrderInputs(orders), orgId);
    }
  }

  return { revenue: 0, cost: 0, profit: 0, margin: 0, costSavedFromPromotion: 0 };
}
