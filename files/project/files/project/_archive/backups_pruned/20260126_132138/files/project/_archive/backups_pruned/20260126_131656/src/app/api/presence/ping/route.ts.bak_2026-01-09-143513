import { NextRequest, NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";
import { getToken } from "next-auth/jwt";

export const runtime = "nodejs";

export async function POST(req: NextRequest) {
  // ดึง userId จาก JWT/cookie (ไม่ต้อง import authOptions/getServerSession)
  const token = await getToken({ req: req as any, secret: process.env.NEXTAUTH_SECRET });
  const userId = (token as any)?.sub || (token as any)?.id || null;

  // ถ้าไม่มี token ก็ไม่ error กันยิงซ้ำ
  if (!userId) return NextResponse.json({ ok: true, skipped: true }, { status: 200 });

  await prisma.user.update({
    where: { id: String(userId) },
    data: { lastSeenAt: new Date() },
  });

  return NextResponse.json({ ok: true }, { status: 200 });
}
