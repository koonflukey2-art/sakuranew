// src/app/api/budgets/route.ts
import { NextRequest, NextResponse } from "next/server";
import { getCurrentUser } from "@/lib/auth";
import { prisma } from "@/lib/db";
import { getOrganizationId } from "@/lib/organization";

export const runtime = "nodejs";

type BudgetItemInput = {
  name: string;
  amount: number;
  quantity?: number;
  notes?: string;
};

type BudgetBody = {
  id?: string;
  name?: string | null;
  description?: string | null;
  totalAmount?: number;
  items?: BudgetItemInput[];
};

// GET /api/budgets
export async function GET() {
  try {
    const user = await getCurrentUser(request);
    if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

    if (user.role !== "ADMIN") {
      return NextResponse.json({ error: "คุณไม่มีสิทธิ์เข้าถึงงบประมาณ" }, { status: 403 });
    }

    const orgId = await getOrganizationId();
    if (!orgId) return NextResponse.json({ error: "No organization found" }, { status: 403 });

    const budgets = await prisma.budget.findMany({
      where: { organizationId: orgId },
      orderBy: { createdAt: "desc" },
      include: { items: true },
    });

    return NextResponse.json(budgets);
  } catch (error) {
    console.error("Failed to fetch budgets:", error);
    return NextResponse.json({ error: "Failed to fetch budgets" }, { status: 500 });
  }
}

// POST /api/budgets
export async function POST(req: NextRequest) {
  try {
    const user = await getCurrentUser(request);
    if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

    if (user.role !== "ADMIN") {
      return NextResponse.json({ error: "คุณไม่มีสิทธิ์สร้างงบประมาณ" }, { status: 403 });
    }

    const orgId = await getOrganizationId();
    if (!orgId) return NextResponse.json({ error: "No organization found" }, { status: 403 });

    const body = (await req.json()) as BudgetBody;

    const totalAmount = Number(body.totalAmount);
    if (!Number.isFinite(totalAmount) || totalAmount <= 0) {
      return NextResponse.json({ error: "totalAmount ต้องเป็นตัวเลขมากกว่า 0" }, { status: 400 });
    }

    const name = typeof body.name === "string" ? body.name.trim() : null;
    const description = typeof body.description === "string" ? body.description.trim() : null;

    const itemsRaw = Array.isArray(body.items) ? body.items : [];
    const validItems = itemsRaw
      .map((it) => ({
        name: typeof it?.name === "string" ? it.name.trim() : "",
        amount: Number(it?.amount),
        quantity: Number(it?.quantity ?? 1),
        notes: typeof it?.notes === "string" ? it.notes.trim() : null,
      }))
      .filter((it) => it.name && Number.isFinite(it.amount) && it.amount >= 0 && Number.isFinite(it.quantity) && it.quantity >= 1);

    const created = await prisma.budget.create({
      data: {
        organizationId: orgId,
        name,
        description,
        totalAmount,
        remaining: totalAmount,
        ...(validItems.length
          ? {
              items: {
                create: validItems.map((it) => ({
                  name: it.name,
                  amount: it.amount,
                  quantity: it.quantity,
                  notes: it.notes,
                })),
              },
            }
          : {}),
      },
      include: { items: true },
    });

    return NextResponse.json(created, { status: 201 });
  } catch (error) {
    console.error("Failed to create budget:", error);
    return NextResponse.json({ error: "Failed to create budget" }, { status: 500 });
  }
}

// PUT /api/budgets
export async function PUT(req: NextRequest) {
  try {
    const user = await getCurrentUser(request);
    if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

    if (user.role !== "ADMIN") {
      return NextResponse.json({ error: "คุณไม่มีสิทธิ์แก้ไขงบประมาณ" }, { status: 403 });
    }

    const orgId = await getOrganizationId();
    if (!orgId) return NextResponse.json({ error: "No organization found" }, { status: 403 });

    const body = (await req.json()) as BudgetBody;
    if (!body.id) return NextResponse.json({ error: "id required" }, { status: 400 });

    // Ensure belongs to org
    const current = await prisma.budget.findFirst({
      where: { id: body.id, organizationId: orgId },
      include: { items: true },
    });
    if (!current) return NextResponse.json({ error: "Budget not found" }, { status: 404 });

    const data: any = {};

    if (body.name !== undefined) {
      data.name = typeof body.name === "string" ? body.name.trim() : null;
    }
    if (body.description !== undefined) {
      data.description = typeof body.description === "string" ? body.description.trim() : null;
    }
    if (body.totalAmount !== undefined) {
      const totalAmount = Number(body.totalAmount);
      if (!Number.isFinite(totalAmount) || totalAmount <= 0) {
        return NextResponse.json({ error: "totalAmount ต้องเป็นตัวเลขมากกว่า 0" }, { status: 400 });
      }
      data.totalAmount = totalAmount;
      data.remaining = totalAmount; // ตาม logic เดิมของคุณ (รีเซ็ต remaining)
    }

    const updated = await prisma.budget.update({
      where: { id: body.id },
      data,
      include: { items: true },
    });

    return NextResponse.json(updated);
  } catch (error) {
    console.error("Failed to update budget:", error);
    return NextResponse.json({ error: "Failed to update budget" }, { status: 500 });
  }
}

// DELETE /api/budgets?id=...
export async function DELETE(req: NextRequest) {
  try {
    const user = await getCurrentUser(request);
    if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });

    if (user.role !== "ADMIN") {
      return NextResponse.json({ error: "คุณไม่มีสิทธิ์ลบงบประมาณ" }, { status: 403 });
    }

    const orgId = await getOrganizationId();
    if (!orgId) return NextResponse.json({ error: "No organization found" }, { status: 403 });

    const { searchParams } = new URL(req.url);
    const id = searchParams.get("id");
    if (!id) return NextResponse.json({ error: "ID required" }, { status: 400 });

    // Ensure belongs to org
    const exists = await prisma.budget.findFirst({ where: { id, organizationId: orgId } });
    if (!exists) return NextResponse.json({ error: "Budget not found" }, { status: 404 });

    await prisma.budget.delete({ where: { id } });
    return NextResponse.json({ success: true });
  } catch (error) {
    console.error("Failed to delete budget:", error);
    return NextResponse.json({ error: "Failed to delete budget" }, { status: 500 });
  }
}
